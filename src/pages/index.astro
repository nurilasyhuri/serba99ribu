---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroVideo from '../components/HeroVideo.astro';
import CategoryNav from '../components/CategoryNav.astro';
import DepartmentSection from '../components/DepartmentSection.astro';
import BuyingGuides from '../components/BuyingGuides.astro';
import AEOKnowledgeSection, { aeoQuestions } from '../components/AEOKnowledgeSection.astro';
import Footer from '../components/Footer.astro';
import { getCategoryGroups, getAllProducts } from '../utils/catalog';
import {
  getOrganizationSchema,
  getWebSiteSchema,
  getItemListSchema,
  getFAQSchema
} from '../utils/seo';

const categoryGroups = getCategoryGroups();
const allProducts = getAllProducts();
const featuredProducts = categoryGroups.flatMap((g) => g.products.slice(0, 2));

const schemas = [
  getOrganizationSchema(),
  getWebSiteSchema(),
  getFAQSchema(aeoQuestions),
  getItemListSchema('Featured Essentials Under Rp 99.000', featuredProducts)
];
---

<BaseLayout
  title="Serba 99ribu — Curated Essentials Under Rp 99.000"
  description="Modern lifestyle essentials curated under Rp 99.000. Discover fashion, beauty, home goods, and automotive accessories with verified quality and clean pricing."
  schemas={schemas}
>
  <!-- 1. Floating Louis Vuitton Navbar -->
  <Header isDarkHero={true} />

  <main class="flex-grow">
    <!-- 2. Full-Bleed Ambient Video Hero -->
    <HeroVideo />

    <!-- 3. Category Quick-Jump Pill Strip -->
    <CategoryNav />

    <!-- 4. Department Sections ("Explore of Selection") -->
    <div id="departemen-list">
      {categoryGroups.map((group) => (
        <DepartmentSection group={group} limit={4} />
      ))}
    </div>

    <!-- 5. Scenario Buying Guides -->
    <BuyingGuides />

    <!-- 6. AEO Knowledge & FAQ Section -->
    <AEOKnowledgeSection />
  </main>

  <!-- 7. Understated Luxury Footer -->
  <Footer />
</BaseLayout>
