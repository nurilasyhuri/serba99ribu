---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { getOrganizationSchema, getWebSiteSchema, getBreadcrumbSchema } from '../../utils/seo';

const articles = (await getCollection('artikel')).sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Editorial & Panduan', url: '/artikel' }
];

const schemas = [
  getOrganizationSchema(),
  getWebSiteSchema(),
  getBreadcrumbSchema(breadcrumbItems)
];
---

<BaseLayout
  title="Panduan Belanja Esensial - Serba 99ribu"
  description="Kumpulan panduan belanja cerdas, ulasan produk esensial, ide gaya hidup modern, dan tips belanja hemat berkualitas di bawah Rp 99.000."
  ogType="website"
  schemas={schemas}
>
  <Header />

  <main class="flex-grow pt-24 sm:pt-28 pb-20">
    <!-- Breadcrumb -->
    <div class="border-b border-hairline bg-surface py-3.5 mb-10">
      <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center space-x-2 text-xs text-muted" aria-label="Breadcrumb">
          <a href="/" class="hover:text-charcoal transition-colors">Home</a>
          <span>/</span>
          <span class="text-charcoal font-medium">Editorial & Panduan</span>
        </nav>
      </div>
    </div>

    <!-- Page Header Header Section -->
    <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8 mb-12 sm:mb-16">
      <div class="max-w-2xl">
        <span class="text-xs uppercase tracking-[0.25em] text-muted font-medium block mb-2">
          Curated Journal
        </span>
        <h1 class="font-editorial text-3xl sm:text-4xl lg:text-5xl text-charcoal font-normal tracking-tight mb-4">
          Editorial & Panduan Belanja
        </h1>
        <p class="text-sm sm:text-base text-muted leading-relaxed font-light">
          Wawasan terkurasi seputar gaya hidup modern, analisis nilai produk esensial, dan panduan belanja cerdas berkualitas dengan batasan maksimal Rp 99.000.
        </p>
      </div>
    </div>

    <!-- Article Listing Grid -->
    <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
      {articles.length === 0 ? (
        <div class="text-center py-20 border border-dashed border-hairline rounded-sm">
          <p class="font-editorial text-xl text-charcoal italic mb-2">Editorial Segera Hadir</p>
          <p class="text-xs text-muted max-w-sm mx-auto">
            Artikel panduan belanja gaya hidup dan ulasan produk esensial sedang dipersiapkan oleh tim kurasi kami.
          </p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10">
          {articles.map((art) => (
            <article class="group flex flex-col justify-between border border-hairline bg-surface hover:shadow-subtle transition-all duration-300">
              <a href={`/artikel/${art.slug}`} class="block overflow-hidden relative aspect-[16/10] bg-hairline/30">
                <img
                  src={art.data.heroImage}
                  alt={art.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                  loading="lazy"
                />
                <span class="absolute top-3 left-3 bg-charcoal/90 text-white text-[10px] uppercase tracking-widest px-2.5 py-1 backdrop-blur-sm">
                  {art.data.category}
                </span>
              </a>

              <div class="p-5 sm:p-6 flex flex-col flex-grow justify-between">
                <div>
                  <div class="text-[11px] text-muted tracking-wider uppercase mb-2">
                    {art.data.publishDate} • {art.data.author}
                  </div>
                  <h2 class="font-editorial text-xl sm:text-2xl text-charcoal group-hover:text-neutral transition-colors line-clamp-2 leading-snug mb-3">
                    <a href={`/artikel/${art.slug}`}>
                      {art.data.title}
                    </a>
                  </h2>
                  <p class="text-xs text-muted leading-relaxed line-clamp-3 mb-6 font-light">
                    {art.data.description}
                  </p>
                </div>

                <div class="pt-4 border-t border-hairline flex items-center justify-between">
                  <a
                    href={`/artikel/${art.slug}`}
                    class="text-xs uppercase tracking-widest font-medium text-charcoal group-hover:opacity-75 inline-flex items-center space-x-1 transition-opacity"
                  >
                    <span>Baca Selengkapnya</span>
                    <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </main>

  <Footer />
</BaseLayout>
