---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getAllProducts, getCategoryBySlug } from '../../utils/catalog';
import {
  getOrganizationSchema,
  getWebSiteSchema,
  getBreadcrumbSchema,
  getProductSchema
} from '../../utils/seo';
import type { ProductItem } from '../../types/catalog';

export function getStaticPaths() {
  const allProducts = getAllProducts();
  return allProducts.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

interface Props {
  product: ProductItem;
}

const { product } = Astro.props;
const category = getCategoryBySlug(product.category);
const relatedProducts = category
  ? category.products.filter((p) => p.slug !== product.slug).slice(0, 4)
  : [];

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  ...(category ? [{ name: category.title, url: `/kategori/${category.slug}` }] : []),
  { name: product.title, url: `/produk/${product.slug}` }
];

const schemas = [
  getOrganizationSchema(),
  getWebSiteSchema(),
  getBreadcrumbSchema(breadcrumbItems),
  getProductSchema(product, category?.title)
];
---

<BaseLayout
  title={`${product.title} — Serba 99ribu`}
  description={product.description || `${product.title} priced at ${product.price}. Curated lifestyle essentials capped under Rp 99.000.`}
  image={product.image}
  ogType="product"
  schemas={schemas}
>
  <Header />

  <main class="flex-grow pt-24 sm:pt-28">
    <!-- Breadcrumb -->
    <div class="border-b border-hairline bg-surface py-3.5">
      <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center space-x-2 text-xs text-muted overflow-x-auto hide-scrollbar" aria-label="Breadcrumb">
          <a href="/" class="hover:text-charcoal transition-colors whitespace-nowrap">Home</a>
          <span>/</span>
          {category && (
            <>
              <a href={`/kategori/${category.slug}`} class="hover:text-charcoal transition-colors whitespace-nowrap">
                {category.title}
              </a>
              <span>/</span>
            </>
          )}
          <span class="text-charcoal font-medium truncate max-w-[200px] sm:max-w-none">{product.title}</span>
        </nav>
      </div>
    </div>

    <!-- Product Detail Section: 2-Column Luxury Layout -->
    <section class="py-10 sm:py-16">
      <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
          
          <!-- Left Column: Packshot (Clean, unbordered stage) -->
          <div class="lg:col-span-7">
            <div class="aspect-square w-full bg-neutral flex items-center justify-center p-6 sm:p-12 overflow-hidden">
              <img
                src={product.image}
                alt={product.alt || product.title}
                loading="eager"
                decoding="async"
                width="640"
                height="640"
                class="w-full h-full object-contain object-center"
              />
            </div>
          </div>

          <!-- Right Column: Product Spec & Outbound CTA -->
          <div class="lg:col-span-5 flex flex-col space-y-6">
            <div class="space-y-2">
              {category && (
                <span class="text-xs uppercase tracking-[0.16em] text-muted font-semibold">
                  {category.title}
                </span>
              )}
              <h1 class="font-editorial text-2xl sm:text-4xl font-semibold text-charcoal leading-tight">
                {product.title}
              </h1>
            </div>

            <!-- Price Row -->
            <div class="py-3 border-y border-hairline flex items-baseline justify-between">
              <div>
                <span class="text-2xl sm:text-3xl font-semibold text-charcoal">
                  {product.price}
                </span>
              </div>
              <span class="text-xs uppercase tracking-wider text-muted font-medium">
                In Stock
              </span>
            </div>

            <!-- Primary Action Button: Link Out Directly to 99ribu.com -->
            <div class="space-y-3 pt-2">
              <a
                href={product.href}
                target="_blank"
                rel="noopener noreferrer sponsored"
                class="w-full py-4 px-6 text-sm font-medium uppercase tracking-[0.14em] text-white bg-charcoal hover:bg-black transition-colors flex items-center justify-center space-x-2 shadow-sm focus:outline-none"
                aria-label={`Buy ${product.title} on 99ribu.com`}
              >
                <span>Buy on 99ribu.com</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </a>

              <p class="text-xs text-muted text-center leading-relaxed">
                Official link to secure checkout on partner platform <strong>99ribu.com</strong>.
              </p>
            </div>

            <!-- Description -->
            <div class="pt-4 space-y-3">
              <h2 class="text-xs uppercase tracking-[0.16em] font-semibold text-charcoal">
                Product Overview
              </h2>
              <p class="text-sm text-muted leading-relaxed">
                {product.description}
              </p>
            </div>

            <!-- Key Features / Specifications -->
            {product.features && product.features.length > 0 && (
              <div class="pt-4 border-t border-hairline space-y-3">
                <h2 class="text-xs uppercase tracking-[0.16em] font-semibold text-charcoal">
                  Specifications &amp; Highlights
                </h2>
                <ul class="space-y-2 text-xs text-muted">
                  {product.features.map((feature) => (
                    <li class="flex items-start space-x-2">
                      <span class="text-charcoal font-bold">&bull;</span>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Quality & Partner Guarantee -->
            <div class="pt-4 border-t border-hairline bg-neutral/40 p-4 text-xs text-muted space-y-1">
              <p class="font-medium text-charcoal">Verified Partner Guarantee</p>
              <p>This item is curated by Serba 99ribu. Order fulfillment, packaging, and shipping are managed directly by registered official suppliers via 99ribu.com.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <section class="py-12 sm:py-16 border-t border-hairline bg-surface">
        <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mb-8 pb-3 border-b border-hairline flex items-baseline justify-between">
            <h2 class="font-editorial text-2xl sm:text-3xl font-semibold text-charcoal">
              More from this Collection
            </h2>
            {category && (
              <a href={`/kategori/${category.slug}`} class="text-xs font-medium text-charcoal hover:text-terracotta transition-colors">
                View All &rarr;
              </a>
            )}
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-x-5 gap-y-10 sm:gap-x-8">
            {relatedProducts.map((rel) => (
              <ProductCard product={rel} categoryLabel={category?.shortTitle} />
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</BaseLayout>
