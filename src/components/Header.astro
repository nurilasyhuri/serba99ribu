---
import { categoryDefinitions } from '../utils/catalog';

interface Props {
  isDarkHero?: boolean;
}

const { isDarkHero = false } = Astro.props;
---

<header
  id="main-header"
  data-dark-hero={isDarkHero ? "true" : "false"}
  class={`fixed top-0 left-0 w-full z-50 transition-colors duration-200 ${
    isDarkHero
      ? 'bg-transparent text-white border-b border-transparent'
      : 'bg-canvas/95 text-charcoal border-b border-hairline backdrop-blur-[8px] shadow-sm'
  }`}
>
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
    <!-- Left: Menu Trigger & Guides -->
    <div class="flex items-center space-x-6 w-1/3">
      <button
        type="button"
        id="menu-open-btn"
        class="flex items-center space-x-2 text-xs uppercase tracking-widest font-medium hover:opacity-80 transition-opacity focus:outline-none"
        aria-label="Open Navigation Menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <span class="hidden sm:inline">Menu</span>
      </button>

      <a
        href="/artikel"
        class="hidden sm:flex items-center space-x-1.5 text-xs uppercase tracking-widest font-medium hover:opacity-80 transition-opacity"
      >
        <span>Editorial</span>
      </a>

      <a
        href="/#panduan-belanja"
        class="hidden md:flex items-center space-x-1.5 text-xs uppercase tracking-widest font-medium hover:opacity-80 transition-opacity"
      >
        <span>Guides</span>
      </a>
    </div>

    <!-- Center: Centered Wordmark (Louis Vuitton Style) -->
    <div class="w-1/3 text-center">
      <a href="/" class="inline-block font-sans text-base sm:text-lg tracking-[0.25em] font-semibold uppercase hover:opacity-90 transition-opacity">
        Serba 99ribu
      </a>
    </div>

    <!-- Right: Quick Navigation & Link Out -->
    <div class="flex items-center justify-end space-x-5 w-1/3 text-xs uppercase tracking-widest font-medium">
      <a href="/#katalog" class="hover:opacity-80 transition-opacity hidden sm:inline">
        Departments
      </a>
      <a
        href="https://99ribu.com"
        target="_blank"
        rel="noopener noreferrer"
        class={`px-3.5 py-1.5 border border-current transition-colors text-xs inline-flex items-center space-x-1 ${
          isDarkHero
            ? 'hover:bg-white hover:text-charcoal'
            : 'hover:bg-charcoal hover:text-white'
        }`}
        aria-label="Visit 99ribu.com platform"
      >
        <span>99ribu.com</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
        </svg>
      </a>
    </div>
  </div>
</header>

<!-- Slide-Over Menu Drawer (Louis Vuitton Style) -->
<div id="menu-drawer-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-[6px] z-[60] opacity-0 pointer-events-none transition-opacity duration-200"></div>

<aside
  id="menu-drawer"
  class="fixed top-0 left-0 h-full w-full sm:w-[440px] bg-canvas text-charcoal z-[70] transform -translate-x-full transition-transform duration-200 ease-out shadow-2xl flex flex-col justify-between overflow-y-auto"
  aria-label="Navigation Menu Drawer"
>
  <div class="p-6 sm:p-8">
    <!-- Drawer Header -->
    <div class="flex items-center justify-between pb-6 border-b border-hairline">
      <span class="text-xs uppercase tracking-[0.2em] font-semibold text-muted">Departments</span>
      <button
        type="button"
        id="menu-close-btn"
        class="p-2 hover:bg-neutral transition-colors text-charcoal focus:outline-none"
        aria-label="Close Menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Category Links to Multipage Category Pages -->
    <nav class="mt-8 space-y-6">
      <div>
        <a
          href="/artikel"
          class="drawer-link group block font-editorial text-2xl sm:text-3xl text-charcoal hover:text-terracotta transition-colors"
        >
          <span class="block">Editorial & Panduan</span>
          <span class="block text-xs font-sans text-muted tracking-wide mt-1 group-hover:text-charcoal transition-colors">
            Tips & lifestyle buying guides &rarr;
          </span>
        </a>
      </div>
      {categoryDefinitions.map((cat) => (
        <div>
          <a
            href={`/kategori/${cat.slug}`}
            class="drawer-link group block font-editorial text-2xl sm:text-3xl text-charcoal hover:text-terracotta transition-colors"
          >
            <span class="block">{cat.title}</span>
            <span class="block text-xs font-sans text-muted tracking-wide mt-1 group-hover:text-charcoal transition-colors">
              Explore collection &rarr;
            </span>
          </a>
        </div>
      ))}
    </nav>
  </div>

  <!-- Drawer Footer -->
  <div class="p-6 sm:p-8 bg-neutral/60 border-t border-hairline">
    <div class="text-xs text-muted leading-relaxed space-y-2">
      <p class="font-medium text-charcoal uppercase tracking-wider">Independent Curation</p>
      <p>Practical lifestyle essentials capped at Rp 99.000. All orders and shipments are fulfilled directly by official merchant partners via 99ribu.com.</p>
    </div>
  </div>
</aside>

<script>
  const header = document.getElementById('main-header');
  const openBtn = document.getElementById('menu-open-btn');
  const closeBtn = document.getElementById('menu-close-btn');
  const backdrop = document.getElementById('menu-drawer-backdrop');
  const drawer = document.getElementById('menu-drawer');
  const drawerLinks = document.querySelectorAll('.drawer-link');
  const hasDarkHero = header?.dataset.darkHero === 'true';

  function updateHeader() {
    if (!header || !hasDarkHero) return;
    if (window.scrollY > 40) {
      header.classList.remove('bg-transparent', 'text-white', 'border-transparent');
      header.classList.add('bg-canvas/95', 'text-charcoal', 'backdrop-blur-[8px]', 'border-hairline', 'shadow-sm');
    } else {
      header.classList.remove('bg-canvas/95', 'text-charcoal', 'backdrop-blur-[8px]', 'border-hairline', 'shadow-sm');
      header.classList.add('bg-transparent', 'text-white', 'border-transparent');
    }
  }

  if (hasDarkHero) {
    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();
  }

  function openDrawer() {
    if (!drawer || !backdrop) return;
    drawer.classList.remove('-translate-x-full');
    backdrop.classList.remove('opacity-0', 'pointer-events-none');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    if (!drawer || !backdrop) return;
    drawer.classList.add('-translate-x-full');
    backdrop.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  drawerLinks.forEach((link) => {
    link.addEventListener('click', closeDrawer);
  });
</script>
