---
import { categoryDefinitions } from '../utils/catalog';
---

<footer class="bg-charcoal text-canvas pt-16 pb-12 border-t border-onyx">
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-white/10">
      <!-- Col 1: Brand & Identity -->
      <div class="md:col-span-2 space-y-4 max-w-md">
        <a href="/" class="inline-block font-sans text-lg tracking-[0.25em] font-semibold uppercase text-white">
          Serba 99ribu
        </a>
        <p class="text-sm text-neutral/80 leading-relaxed font-editorial italic text-base">
          Modern lifestyle essentials curated under Rp 99.000.
        </p>
        <p class="text-xs text-neutral/60 leading-relaxed">
          Bringing a selective collection of home goods, beauty, apparel, and automotive accessories from verified partner merchants.
        </p>
      </div>

      <!-- Col 2: Departments -->
      <div class="space-y-3">
        <span class="block text-xs uppercase tracking-[0.16em] font-semibold text-white/90">
          Departments
        </span>
        <ul class="space-y-1 text-xs text-neutral/70">
          {categoryDefinitions.map((cat) => (
            <li>
              <a href={`/kategori/${cat.slug}`} class="hover:text-white transition-colors inline-block py-1.5">
                {cat.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Outbound & Guides -->
      <div class="space-y-3">
        <span class="block text-xs uppercase tracking-[0.16em] font-semibold text-white/90">
          Explore
        </span>
        <ul class="space-y-1 text-xs text-neutral/70">
          <li>
            <a href="https://99ribu.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors inline-flex items-center space-x-1 py-1.5">
              <span>99ribu.com Platform</span>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
              </svg>
            </a>
          </li>
          <li>
            <a href="/artikel" class="hover:text-white transition-colors inline-block py-1.5">
              Editorial & Panduan Belanja
            </a>
          </li>
          <li>
            <a href="/#panduan-belanja" class="hover:text-white transition-colors inline-block py-1.5">
              Lifestyle Buying Guides
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom: Transparency & Copyright -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-neutral/60 space-y-4 md:space-y-0">
      <div class="max-w-xl text-center md:text-left leading-relaxed">
        <p>
          <strong class="text-white/80">Affiliate Disclosure:</strong> Serba 99ribu is an independent product curator. Orders, packaging, and fulfillment are processed directly by official merchant partners via 99ribu.com.
        </p>
      </div>

      <div class="text-center md:text-right whitespace-nowrap text-xs text-neutral/60">
        <p>&copy; {new Date().getFullYear()} Serba 99ribu. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>
