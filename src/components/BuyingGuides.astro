---
import { buyingGuides } from '../utils/catalog';
---

<section id="panduan-belanja" class="py-16 sm:py-24 bg-neutral/50 border-b border-hairline">
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="max-w-2xl mb-12 sm:mb-16 space-y-2">
      <h2 class="font-editorial text-2xl sm:text-4xl font-semibold text-charcoal">
        Everyday Living, Curated Under 99K
      </h2>
      <p class="text-sm text-muted leading-relaxed">
        Thoughtful recommendations on functional essentials that bring daily utility and calm to your routine.
      </p>
    </div>

    <!-- 3-Column Editorial Grid: Borderless, Flat, Architectural -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 sm:gap-10">
      {buyingGuides.map((guide) => (
        <article class="group flex flex-col justify-between">
          <div>
            <a href={guide.targetAnchor} class="block aspect-[16/10] w-full overflow-hidden bg-neutral focus:outline-none">
              <img
                src={guide.image}
                alt={guide.title}
                loading="lazy"
                decoding="async"
                width="600"
                height="375"
                class="w-full h-full object-contain p-6 transition-transform duration-300 ease-out group-hover:scale-105"
              />
            </a>

            <div class="pt-4 space-y-2">
              <h3 class="font-editorial text-xl sm:text-2xl font-semibold text-charcoal group-hover:text-terracotta transition-colors leading-snug">
                <a href={guide.targetAnchor}>
                  {guide.title}
                </a>
              </h3>
              <p class="text-sm text-muted leading-relaxed">
                {guide.summary}
              </p>
            </div>
          </div>

          <div class="pt-4">
            <a
              href={guide.targetAnchor}
              class="inline-flex items-center space-x-1.5 text-xs font-semibold text-charcoal hover:text-terracotta transition-colors"
            >
              <span>Explore Collection</span>
              <span>&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
